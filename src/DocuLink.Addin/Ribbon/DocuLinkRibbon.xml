<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="Ribbon_Load">
  <ribbon>
    <tabs>
      <tab id="DocuLink.Tab" label="DocuLink">
        <group id="DocuLink.Group.General" label="General">
          <menu id="DocuLink.MenuViewer"
                label="Viewer"
                size="large"
                itemSize="large"
                getImage="GetViewerMenuImage">
            <button id="DocuLink.BtnTaskPane"
                    label="Open in Task Pane"
                    screentip="Open Viewer in Task Pane"
                    supertip="Keep the document viewer docked beside your worksheet."
                    getImage="GetTaskPaneImage"
                    onAction="OnShowTaskPane" />
            <button id="DocuLink.BtnViewerWindow"
                    label="Open in Separate Window"
                    screentip="Open Viewer in Separate Window"
                    supertip="Open the document viewer in its own resizable window."
                    getImage="GetViewerWindowImage"
                    onAction="OnShowViewerWindow" />
            <toggleButton id="DocuLink.ToggleAutoOpenViewer"
                          getLabel="GetAutoOpenViewerLabel"
                          screentip="Auto-open Viewer for Linked Cells"
                          supertip="During this Excel session, automatically show the viewer when you select a cell linked to a document."
                          getImage="GetAutoOpenViewerImage"
                          getPressed="GetAutoOpenViewerOnCellClick"
                          onAction="OnToggleAutoOpenViewerOnCellClick" />
          </menu>
          <menu id="DocuLink.MenuAddDocuments"
                label="Add Documents"
                size="large"
                itemSize="large"
                getImage="GetAddPdfImage">
            <button id="DocuLink.BtnAddFiles"
                    label="Add Files..."
                    screentip="Add Files"
                    supertip="Choose one or more documents to add to the active workbook."
                    getImage="GetAddFilesImage"
                    onAction="OnAddPdfDocuments" />
            <button id="DocuLink.BtnAddFromClipboard"
                    label="Import from Clipboard"
                    screentip="Import from Clipboard"
                    supertip="Add files or folders that you copied to the Windows clipboard."
                    getImage="GetImportClipboardImage"
                    onAction="OnImportDocumentsFromClipboard" />
            <button id="DocuLink.BtnAddFolder"
                    label="Import Folder..."
                    screentip="Import Folder"
                    supertip="Choose a folder and add its supported documents, including documents in subfolders."
                    getImage="GetImportFolderImage"
                    onAction="OnImportDocumentFolder" />
          </menu>
          <button id="DocuLink.BtnDeleteLinks"
                  label="Delete Links"
                  size="large"
                  getImage="GetDeleteLinksImage"
                  onAction="OnDeleteLinksInSelection" />
          <button id="DocuLink.BtnManageFiles"
                  label="Manage Files"
                  size="large"
                  getImage="GetManageFilesImage"
                  onAction="OnManageFiles" />
          <button id="DocuLink.BtnMatchDocuments"
                  label="Match Documents"
                  size="large"
                  getImage="GetMatchDocumentsImage"
                  onAction="OnMatchDocuments" />
        </group>
        <group id="DocuLink.Group.Help" label=" ">
          <button id="DocuLink.BtnSettings"
                  label="Settings"
                  size="large"
                  getImage="GetSettingsImage"
                  onAction="OnOpenSettings" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
