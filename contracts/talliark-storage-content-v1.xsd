<?xml version="1.0" encoding="utf-8"?>
<!--
  Content Custom XML part: metadata only.
  Binary data (PDF bytes + geometry) lives in per-PDF Custom XML parts with namespace:
    urn:talliark:schemas:storage:1:pdf-data:{pdfId}
  See talliark-storage-pdf-binary-v1.xsd for that schema.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:talliark:schemas:storage:1:content"
           xmlns:tns="urn:talliark:schemas:storage:1:content"
           elementFormDefault="qualified">

  <xs:element name="TalliarkContent" type="tns:TalliarkContentType" />

  <xs:complexType name="TalliarkContentType">
    <xs:sequence>
      <xs:element name="Folders" type="tns:FoldersType" />
      <xs:element name="Pdfs" type="tns:PdfsType" />
    </xs:sequence>
    <xs:attribute name="version" type="xs:unsignedInt" use="required" />
  </xs:complexType>

  <xs:complexType name="FoldersType">
    <xs:sequence>
      <xs:element name="Folder" type="tns:FolderType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FolderType">
    <xs:attribute name="id"   type="xs:string" use="required" />
    <xs:attribute name="name" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="PdfsType">
    <xs:sequence>
      <xs:element name="Pdf" type="tns:PdfType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PdfType">
    <xs:sequence>
      <xs:element name="PageRotations" type="tns:PageRotationsType" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attribute name="id"            type="xs:string"   use="required" />
    <xs:attribute name="name"          type="xs:string"   use="required" />
    <xs:attribute name="folderId"      type="xs:string"   use="optional" />
    <xs:attribute name="dateAdded"     type="xs:dateTime" use="optional" />
    <xs:attribute name="fileSizeBytes" type="xs:long"     use="optional" />
    <xs:attribute name="ocrStatus"     type="xs:string"   use="optional" />
  </xs:complexType>

  <xs:complexType name="PageRotationsType">
    <xs:sequence>
      <xs:element name="Page" type="tns:PageRotationType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PageRotationType">
    <xs:attribute name="index"    type="xs:unsignedInt" use="required" />
    <xs:attribute name="rotation" type="xs:unsignedInt" use="required" />
  </xs:complexType>

</xs:schema>
